generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid()) @db.VarChar
  phone     String    @unique @db.VarChar
  password  String    @db.VarChar
  name      String    @db.VarChar
  avatar    String?   @db.VarChar
  createdat DateTime? @default(now()) @db.Timestamp(6)
  updatedat DateTime? @default(now()) @db.Timestamp(6)
}

model Member {
  id            String         @id @default(cuid()) @db.VarChar
  name          String         @db.VarChar
  phone         String         @unique @db.VarChar
  email         String?        @db.VarChar
  company       String         @db.VarChar
  position      String?        @db.VarChar
  joindate      DateTime?      @default(now()) @db.Timestamp(6)
  status        String?        @default("active") @db.VarChar
  district      String?        @db.VarChar
  chamberTitle  String?        @db.VarChar
  createdat     DateTime?      @default(now()) @db.Timestamp(6)
  updatedat     DateTime?      @default(now()) @db.Timestamp(6)

  registrations Registration[]

  @@index([phone])
  @@index([status])
}

model Company {
  id          String    @id @default(cuid()) @db.VarChar
  name        String    @unique @db.VarChar
  industry    String?   @db.VarChar
  contactName String?   @db.VarChar
  phone       String?   @db.VarChar
  address     String?   @db.VarChar
  logo        String?   @db.VarChar
  status      String?   @default("active") @db.VarChar
  summary     String?   @db.VarChar
  createdat   DateTime? @default(now()) @db.Timestamp(6)
  updatedat   DateTime? @default(now()) @db.Timestamp(6)

  products    CompanyProduct[]

  @@index([status])
  @@index([name])
  @@index([industry])
}

model CompanyProduct {
  id          String    @id @default(cuid()) @db.VarChar
  companyId   String    @db.VarChar
  name        String    @db.VarChar
  description String?   @db.VarChar
  imageUrl    String?   @db.VarChar
  sortOrder   Int?      @default(0)
  createdat   DateTime? @default(now()) @db.Timestamp(6)
  updatedat   DateTime? @default(now()) @db.Timestamp(6)

  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model CivilServant {
  id          String    @id @default(cuid()) @db.VarChar
  name        String    @db.VarChar
  department  String?   @db.VarChar
  position    String?   @db.VarChar
  phone       String?   @db.VarChar
  email       String?   @db.VarChar
  status      String?   @default("active") @db.VarChar
  createdat   DateTime? @default(now()) @db.Timestamp(6)
  updatedat   DateTime? @default(now()) @db.Timestamp(6)

  @@index([status])
  @@index([name])
  @@index([department])
}

model Activity {
  id                  String        @id @default(cuid()) @db.VarChar
  title               String        @db.VarChar
  description         String?
  date                DateTime      @db.Timestamp(6)
  location            String        @db.VarChar
  maxparticipants     Int
  currentparticipants Int?          @default(0)
  status              String?       @default("upcoming") @db.VarChar
  createdat           DateTime?     @default(now()) @db.Timestamp(6)
  updatedat           DateTime?     @default(now()) @db.Timestamp(6)

  registrations       Registration[]
  photos              ActivityPhoto[]

  @@index([date])
  @@index([status])
}

model ActivityPhoto {
  id          String    @id @default(cuid()) @db.VarChar
  activityId  String    @db.VarChar
  imageUrl    String    @db.VarChar
  caption     String?   @db.VarChar
  sortorder   Int?      @default(0)
  createdat   DateTime? @default(now()) @db.Timestamp(6)

  activity    Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId])
}

model Registration {
  id          String    @id @default(cuid()) @db.VarChar
  memberId    String    @db.VarChar
  activityId  String    @db.VarChar
  status      String?   @default("registered") @db.VarChar
  createdat   DateTime? @default(now()) @db.Timestamp(6)
  updatedat   DateTime? @default(now()) @db.Timestamp(6)

  member      Member    @relation(fields: [memberId], references: [id])
  activity    Activity  @relation(fields: [activityId], references: [id])

  @@unique([memberId, activityId])
  @@index([memberId])
  @@index([activityId])
}
